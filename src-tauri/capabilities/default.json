{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for LEGION2",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "nmap",
          "cmd": "nmap",
          "args": true
        },
        {
          "name": "masscan",
          "cmd": "masscan", 
          "args": true
        },
        {
          "name": "pkexec",
          "cmd": "pkexec",
          "args": true
        },
        {
          "name": "legion2-nmap",
          "cmd": "legion2-nmap",
          "args": true
        },
        {
          "name": "legion2-masscan",
          "cmd": "legion2-masscan",
          "args": true
        }
      ]
    }
  ]
}