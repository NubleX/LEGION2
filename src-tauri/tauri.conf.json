{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "decorations": true,
        "height": 1080,
        "label": "main",
        "maximized": true,
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "LEGION2",
        "visible": true,
        "width": 1920
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2025 Igor Dunaev / NubleX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "dialogImagePath": "icons/icon.png"
      }
    }
  },
  "identifier": "com.nublex.legion2",
  "productName": "LEGION2",
  "version": "0.3.2"
}