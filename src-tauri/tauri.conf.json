{
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "label": "main",
        "resizable": true,
        "title": "LEGION2",
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2025 NubleX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.legion2.app",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "productName": "LEGION2",
  "version": "0.3.0"
}